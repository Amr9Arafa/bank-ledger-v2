# Copy to .env.local and fill in real values. Never commit .env.local.

# Public by design (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server-only admin key, used to create users from Settings
SUPABASE_SECRET_KEY=sb_secret_xxx

# Secret: app runtime, transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Secret: drizzle-kit migrations, session pooler (port 5432)
DATABASE_URL_MIGRATIONS=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Secret: AI Inbox extraction (server only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-xxx
# Config (not secret): which model reads what. Both optional; these are the defaults.
# Typed messages: a fast, cheap model is enough.
EXTRACTION_MODEL=claude-haiku-5-5
# Cheque photos: handwriting needs a stronger model.
VISION_MODEL=claude-sonnet-5-5

# Secret: Telegram bot (AI Inbox input). Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
# Secret: Telegram sends it with every webhook call. 1-256 chars of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=a-long-random-string
